# Add your GitHub token here
GITHUB_TOKEN = "your_github_pat_here" 

@bot.command()
async def update(ctx):
    await ctx.send("🔄 Authenticating and pulling from private repository...")
    
    # Use the RAW URL
    url = "https://raw.githubusercontent.com/nimjohn98-sys/steam-manifest-bot/main/bot.py"
    
    # Add the Authorization Header
    headers = {
        "Authorization": f"token {GITHUB_TOKEN}",
        "Accept": "application/vnd.github.v3.raw" # This tells GitHub to send just the code
    }
    
    try:
        r = requests.get(url, headers=headers)
        
        if r.status_code == 200:
            # Re-run the downloaded code in the current session
            exec(r.text, globals())
            await ctx.send("✅ **Private update successful!** New logic applied.")
        elif r.status_code == 404:
            await ctx.send("❌ **Error 404:** File not found. Check if the URL or Token is correct.")
        elif r.status_code == 401:
            await ctx.send("❌ **Error 401:** Unauthorized. Your GitHub Token is invalid.")
        else:
            await ctx.send(f"❌ Failed to reach GitHub (Status: {r.status_code})")
            
    except Exception as e:
        await ctx.send(f"🚨 Update error: {e}")